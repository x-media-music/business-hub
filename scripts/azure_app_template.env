# Azure-App-Credentials — TEMPLATE
# Kopiere diese Datei nach azure_app.env (im gleichen Ordner) und fülle die Werte
# siehe scripts/README.md für die Schritt-für-Schritt-Anleitung

CLIENT_ID=<Azure-App-Registration-Anwendungs-ID>
TENANT_ID=<Azure-Verzeichnis-Mandanten-ID>
CLIENT_SECRET=<Geheimer-Clientschluessel>
OWNER_EMAIL=<deine-primaer-mail@beispiel.de>
REDIRECT_URI=http://localhost:8080
