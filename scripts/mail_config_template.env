# Mail-Konfiguration x-media Hub — Strato IMAP/SMTP
# --------------------------------------------------
# Diese Datei kopieren nach:  scripts/mail.env
# und die beiden Passwort-Zeilen ausfüllen.
# scripts/mail.env ist per .gitignore geschützt und bleibt LOKAL.
#
#   cp scripts/mail_config_template.env scripts/mail.env
#   # dann scripts/mail.env öffnen und Passwörter eintragen
#
# Strato-Serverdaten (Stand 07/2026) — normalerweise nicht ändern:
IMAP_HOST=imap.strato.de
IMAP_PORT=993
SMTP_HOST=smtp.strato.de
SMTP_PORT=465

# Postfach 1: info@ (allgemeine Korrespondenz, Absender Owner/Sekretärin)
MAIL_INFO_ADDRESS=info@xmedia24.com
MAIL_INFO_PASSWORD=

# Postfach 2: rechnung@ (Belege / Buchhaltung)
MAIL_RECHNUNG_ADDRESS=rechnung@xmedia24.com
MAIL_RECHNUNG_PASSWORD=

# Postfach 3: info@ x-media event GmbH
MAIL_INFO_EVENT_ADDRESS=info@xmedia-event.de
MAIL_INFO_EVENT_PASSWORD=
# Postfach 4: rechnung@ x-media event GmbH
MAIL_RECHNUNG_EVENT_ADDRESS=rechnung@xmedia-event.de
MAIL_RECHNUNG_EVENT_PASSWORD=
